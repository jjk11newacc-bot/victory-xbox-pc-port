+/// Where `a` and `b` (of one length) first differ, compared eight bytes at
+/// a time.
+pub fn first_difference(a: &[u8], b: &[u8]) -> Option<usize> {
+    let whole = a.len().min(b.len()) / 8 * 8;
+    let from = a[..whole]
+        .as_chunks::<8>().0.iter()
+        .zip(b[..whole].chunks_exact(8))
