+
+/// Where `a` and `b` (of one length) last differ.
+pub fn last_difference(a: &[u8], b: &[u8]) -> Option<usize> {
+    let whole = a.len().min(b.len()) / 8 * 8;
+    if let Some(i) = a[whole..].iter().zip(&b[whole..]).rposition(|(x, y)| x != y) {
+        return Some(whole + i);
+    }
+    let word = a[..whole]
+        .as_chunks::<8>().0.iter()
+        .zip(b[..whole].chunks_exact(8))
+        .rposition(|(x, y)| x != y)?
+        * 8;
+    a[word..word + 8]
+        .iter()
+        .zip(&b[word..word + 8])
+        .rposition(|(x, y)| x != y)
+        .map(|i| word + i)
+}
