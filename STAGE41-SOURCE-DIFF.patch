+fn hash_overlap(previous: &mut Option<(u64, u32)>, id: u64, first: u32, pieces: u32) -> bool {
+    let end = first.saturating_add(pieces);
+    let overlap = previous.is_some_and(|(old, last)| old == id && first < last);
